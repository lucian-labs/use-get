{
  "name": "@dank-inc/use-get",
  "version": "0.4.0",
  "author": "Elijah Lucian",
  "description": "A few typscript react hook to get you that sweet sweet data from an endpoint.",
  "repository": {
    "url": "https://github.com/dank-inc/use-get"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
